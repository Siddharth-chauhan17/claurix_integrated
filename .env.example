# Used by docker-compose for variable substitution (place in project root).
# Copy to .env and fill in. For Google OAuth, you can copy GOOGLE_* from backend/.env.

SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
