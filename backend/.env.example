# Copy to .env and set in production

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/claurix

# JWT (generate with: openssl rand -hex 32)
SECRET_KEY=9f3a8c1e2b4d7e6f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
# When using Docker, also set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET in a .env file
# in the project root (same folder as docker-compose.yml) so the API container receives them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Pre-production identity reset — NEVER true in pilot or production (wipes all users/orgs/clients)
RESET_IDENTITY_ON_STARTUP=false

# Gap analysis AI (off by default — mock QCR generator used until AI_ENABLED=true)
# When true: POST /projects/{id}/generate-qcr runs Ollama pipeline on server-uploaded quote Excel files.
AI_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL_NAME=qwen2.5:7b

# Admin emails allowed to list demo leads (GET /demo-requests). Comma-separated.
DEMO_REQUEST_ADMIN_EMAILS=you@company.com

# Microsoft / Outlook mailbox integration (separate from Google login)
MICROSOFT_CLIENT_ID=2a0ce8d6-f744-4953-80d1-1c4de1e1c4c9
MICROSOFT_CLIENT_SECRET=aa70ec8f-54d3-41a9-8ab1-067d4bdc7ae7
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/integrations/outlook/callback

# Frontend base URL (Outlook OAuth redirect after connect)
FRONTEND_BASE_URL=http://localhost:3000

# Outlook attachment import max size in MB (Outlook imports only)
OUTLOOK_MAX_IMPORT_SIZE_MB=25

# Set true when API runs over HTTPS (auto-detected from MICROSOFT_REDIRECT_URI if unset)
# OUTLOOK_OAUTH_COOKIE_SECURE=true

# Fernet key for Outlook token encryption at rest (required for new connects / migration)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OUTLOOK_TOKEN_ENCRYPTION_KEY=

# Optional
# DEBUG=false
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# BCRYPT_ROUNDS=12
