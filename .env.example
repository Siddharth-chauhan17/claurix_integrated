# Used by docker-compose for variable substitution (place in project root).
# Copy to .env and fill in. For Google OAuth, you can copy GOOGLE_* from backend/.env.

SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Gap analysis AI (set AI_ENABLED=true to test real Ollama pipeline)
AI_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_MODEL_NAME=qwen2.5:7b

# Comma-separated emails allowed to GET /demo-requests (demo lead admin list)
DEMO_REQUEST_ADMIN_EMAILS=

# Microsoft / Outlook mailbox integration
MICROSOFT_CLIENT_ID=2a0ce8d6-f744-4953-80d1-1c4de1e1c4c9
MICROSOFT_CLIENT_SECRET=aa70ec8f-54d3-41a9-8ab1-067d4bdc7ae7
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/integrations/outlook/callback
