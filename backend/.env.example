# Copy to .env and set in production

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/claurix

# JWT (generate with: openssl rand -hex 32)
SECRET_KEY=9f3a8c1e2b4d7e6f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
# When using Docker, also set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET in a .env file
# in the project root (same folder as docker-compose.yml) so the API container receives them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Pre-production identity reset (wipes users/orgs/clients on API startup; set false once stable)
RESET_IDENTITY_ON_STARTUP=true

# Gap analysis AI (off by default — mock QCR generator used until AI_ENABLED=true)
# When true: POST /projects/{id}/generate-qcr runs Ollama pipeline on server-uploaded quote Excel files.
AI_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL_NAME=qwen2.5:7b

# Optional
# DEBUG=false
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# BCRYPT_ROUNDS=12
